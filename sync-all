# Safe bash settings and options
set -euo pipefail
shopt -s nullglob

# Usage and option parsing
usage() {
  cat <<EOF
Usage: $0 [--dry-run] [--keep-tmp] [--verbose] <package>

Options:
  --dry-run   Show actions without extracting files
  --keep-tmp  Keep files in tmp/ after operation
  --verbose   Show additional info
  --help      Show this help
EOF
  exit 1
}

DRY_RUN=false
KEEP_TMP=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --keep-tmp) KEEP_TMP=true; shift ;;
    --verbose) VERBOSE=true; shift ;;
    --help) usage ;;
    --*) echo "Unknown option: $1"; usage ;;
    *) break ;;
  esac
done

# Check positional argument
if [ $# -lt 1 ]; then
  echo "Error: package argument is missing."
  usage
fi

# Initialize variables
PKG="$1"
APPDIR="$PKG.AppDir"

# Make AppDir folder
mkdir -p "$APPDIR"

verbose() { $VERBOSE && echo "$@"; }

# Find rpm files
files=(tmp/*.rpm)
if [ ${#files[@]} -eq 0 ]; then
  verbose "No RPMs found in tmp/; nothing to do."
  exit 0
fi

# Loop through all RPM files in tmp folder and extract all
for rpm_file in "${files[@]}"; do
  [ -f "$rpm_file" ] || continue

  echo "Extracting $rpm_file to AppDir"
  if $DRY_RUN; then
    echo "DRY-RUN: would extract $rpm_file to $APPDIR"
    continue
  fi

  if rpm2cpio "$rpm_file" | (cd "$APPDIR" && cpio -idm); then
    verbose "Successfully extracted $rpm_file"
    rm -f -- "$rpm_file"
  else
    echo "Error: failed to extract $rpm_file" >&2
    exit 1
  fi
done

# Cleanup tmp unless requested to keep (don't delete in dry-run)
if [ "$KEEP_TMP" = false ] && [ "$DRY_RUN" = false ]; then
  rm -f -- tmp/*.rpm || true
fi

