#!/bin/sh
HERE="$(dirname "$(readlink -f "${0}")")"

# Source app-specific environment files if they exist (generated by app-fixes.sh)
[ -f "${HERE}/gimp-env.sh" ] && . "${HERE}/gimp-env.sh"
[ -f "${HERE}/gweather-env.sh" ] && . "${HERE}/gweather-env.sh"

# PATH
export PATH="${HERE}:${HERE}/usr/bin/:${HERE}/usr/sbin/:${HERE}/usr/games/:${HERE}/bin/:${HERE}/sbin/${PATH:+:$PATH}"

# LD_LIBRARY_PATH - use pre-generated lib.path if available (faster startup)
# lib.path contains relative paths with + prefix, one per line
if [ -f "${HERE}/lib.path" ]; then
  while IFS= read -r line; do
    # Remove the + prefix and prepend HERE
    dir="${line#+}"
    export LD_LIBRARY_PATH="${HERE}${dir}:${LD_LIBRARY_PATH}"
  done < "${HERE}/lib.path"
else
  # Fallback: dynamically add subdirectories of usr/lib and usr/lib64
  if [ -d "${HERE}/usr/lib" ]; then
    for d in $(find "${HERE}/usr/lib" -type d 2>/dev/null); do
      export LD_LIBRARY_PATH="${d}:${LD_LIBRARY_PATH}"
    done
  fi
  if [ -d "${HERE}/usr/lib64" ]; then
    for d in $(find "${HERE}/usr/lib64" -type d 2>/dev/null); do
      export LD_LIBRARY_PATH="${d}:${LD_LIBRARY_PATH}"
    done
  fi
fi
# Add standard library paths (ensure they're always present)
export LD_LIBRARY_PATH="${HERE}/usr/lib/:${HERE}/usr/lib/x86_64-linux-gnu/:${HERE}/usr/lib64/:${HERE}/lib/:${HERE}/lib64/:${HERE}/lib/x86_64-linux-gnu/${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
#export LD_LIBRARY_PATH=/lib/:/lib64/:/lib/x86_64-linux-gnu/:/usr/lib/:"${LD_LIBRARY_PATH}" # Uncomment to use system libraries

# XDG_DATA_DIRS
DEFAULT_XDG_DATA_DIRS='./share/:/usr/share/gnome:/usr/local/share/:/usr/share/'
export XDG_DATA_DIRS="${HERE}/usr/share/:${XDG_DATA_DIRS:-$DEFAULT_XDG_DATA_DIRS}"

# GTK icon theme paths
export GTK_DATA_PREFIX="${HERE}/usr"
# Note: XDG_DATA_HOME should remain pointing to user's home (~/.local/share by default)
# Do NOT set it to the AppImage's read-only filesystem, or GTK will fail to write recently-used.xbel
export XCURSOR_PATH="${HERE}/usr/share/icons${XCURSOR_PATH:+:$XCURSOR_PATH}"

# Python - dynamically detect version
# Only set PYTHONHOME if a full Python installation is bundled (has encodings module)
# Apps like Krita only bundle site-packages and need system Python stdlib
if test -d "${HERE}"/usr/lib/python*; then
  PYTHONVERSION=$(find "${HERE}"/usr/lib -maxdepth 1 -type d -name "python*" | head -1 | sed 's:.*/::')
  export PYTHONPATH="${HERE}/usr/share/pyshared/:${HERE}/usr/lib/${PYTHONVERSION}/site-packages/:${HERE}/usr/lib/${PYTHONVERSION}/lib-dynload/${PYTHONPATH:+:$PYTHONPATH}"
  # Only set PYTHONHOME if we have a complete Python (check for encodings module)
  if [ -d "${HERE}/usr/lib/${PYTHONVERSION}/encodings" ]; then
    export PYTHONHOME="${HERE}/usr/"
  fi
fi

# Perl
export PERLLIB="${HERE}/usr/share/perl5/:${HERE}/usr/lib/perl5/${PERLLIB:+:$PERLLIB}"

# GObject Introspection
export GI_TYPELIB_PATH="${HERE}/usr/lib/girepository-1.0/:${HERE}/usr/lib64/girepository-1.0/:${HERE}/usr/lib64/gjs/girepository-1.0/:/usr/lib64/girepository-1.0/:/usr/lib/girepository-1.0/${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"

# GSettings
export GSETTINGS_SCHEMA_DIR="${HERE}/usr/share/glib-2.0/schemas/${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"

# Grilo media framework
export GRL_PLUGIN_PATH="${HERE}/usr/lib64/grilo-0.3/:${HERE}/usr/lib/grilo-0.3/${GRL_PLUGIN_PATH:+:$GRL_PLUGIN_PATH}"

# GEGL image processing framework (used by GNOME Photos, GIMP, etc.)
export GEGL_PATH="${HERE}/usr/lib64/gegl-0.4/:${HERE}/usr/lib/gegl-0.4/${GEGL_PATH:+:$GEGL_PATH}"

# BABL pixel format conversion library (used by GEGL)
export BABL_PATH="${HERE}/usr/lib64/babl-0.1/:${HERE}/usr/lib/babl-0.1/${BABL_PATH:+:$BABL_PATH}"

# Evolution Data Server / Camel
export CAMEL_PROVIDER_PATH="${HERE}/usr/lib64/evolution-data-server/camel-providers/:${HERE}/usr/lib/evolution-data-server/camel-providers/"

# GStreamer
export GST_PLUGIN_SCANNER="${HERE}/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
export GST_PLUGIN_PATH="${HERE}/usr/lib64/gstreamer-1.0/:${HERE}/usr/lib/gstreamer-1.0/${GST_PLUGIN_PATH:+:$GST_PLUGIN_PATH}"

# Qt - dynamically detect version and set plugin path
QTVER=$(find "${HERE}"/usr/lib "${HERE}"/usr/lib64 -maxdepth 1 -type d -name "qt*" 2>/dev/null | head -1 | sed 's:.*/::')
if [ -n "$QTVER" ]; then
  export QT_PLUGIN_PATH="${HERE}/usr/lib/${QTVER}/plugins/:${HERE}/usr/lib/x86_64-linux-gnu/${QTVER}/plugins/:${HERE}/usr/lib64/${QTVER}/plugins/:${HERE}/lib/${QTVER}/plugins/:${HERE}/lib64/${QTVER}/plugins/${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
  export QML2_IMPORT_PATH="${HERE}/usr/lib64/qml/:${HERE}/usr/lib/qml/:${HERE}/usr/lib/${QTVER}/qml/:${HERE}/usr/lib64/${QTVER}/qml/${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
else
  export QT_PLUGIN_PATH="${HERE}/usr/lib64/plugins/:${HERE}/usr/lib/plugins/:${HERE}/usr/lib/qt4/plugins/:${HERE}/usr/lib/i386-linux-gnu/qt4/plugins/:${HERE}/usr/lib/x86_64-linux-gnu/qt4/plugins/:${HERE}/usr/lib32/qt4/plugins/:${HERE}/usr/lib64/qt4/plugins/:${HERE}/usr/lib/qt5/plugins/:${HERE}/usr/lib/i386-linux-gnu/qt5/plugins/:${HERE}/usr/lib/x86_64-linux-gnu/qt5/plugins/:${HERE}/usr/lib32/qt5/plugins/:${HERE}/usr/lib/qt6/plugins/:${HERE}/usr/lib64/qt6/plugins/:${HERE}/usr/lib64/qt5/plugins/${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
  export QML2_IMPORT_PATH="${HERE}/usr/lib64/qml/:${HERE}/usr/lib/qml/:${HERE}/usr/lib/qt5/qml/:${HERE}/usr/lib64/qt5/qml/${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
fi

# GNOME Folks
export FOLKS_BACKEND_PATH="${HERE}/usr/lib64/folks/26/backends/${FOLKS_BACKEND_PATH:+:$FOLKS_BACKEND_PATH}"

# WebKitGTK - dynamically detect version and set paths for helper processes
# WebKitGTK has hardcoded paths to /usr/libexec/webkitgtk-X.Y/
# The most reliable fix is to create symlinks in a writable location
# and use LD_PRELOAD or mount namespaces, but we'll try the simple approach first
WEBKIT_APPIMAGE_FIX=""
for webkitdir in "${HERE}"/usr/libexec/webkitgtk-*; do
  if [ -d "$webkitdir" ]; then
    WEBKIT_VER=$(basename "$webkitdir")
    # WebKit injected bundle path for extensions
    export WEBKIT2_INJECTED_BUNDLE_PATH="${HERE}/usr/lib64/${WEBKIT_VER}/injected-bundle:${HERE}/usr/lib/${WEBKIT_VER}/injected-bundle"
    # Disable sandbox as it doesn't work in AppImages (would need bwrap at hardcoded paths)
    export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
    # Create temporary symlink directory structure for WebKit helpers
    # WebKit looks for helpers in /usr/libexec/webkitgtk-X.Y/
    WEBKIT_TMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/appimage-webkit-$$"
    if mkdir -p "$WEBKIT_TMP_DIR/usr/libexec/$WEBKIT_VER" 2>/dev/null; then
      for helper in WebKitNetworkProcess WebKitWebProcess WebKitGPUProcess; do
        if [ -f "${HERE}/usr/libexec/$WEBKIT_VER/$helper" ]; then
          ln -sf "${HERE}/usr/libexec/$WEBKIT_VER/$helper" "$WEBKIT_TMP_DIR/usr/libexec/$WEBKIT_VER/$helper"
        fi
      done
      # Also symlink the injected bundle directory
      if [ -d "${HERE}/usr/lib64/$WEBKIT_VER" ]; then
        mkdir -p "$WEBKIT_TMP_DIR/usr/lib64/$WEBKIT_VER" 2>/dev/null
        ln -sf "${HERE}/usr/lib64/$WEBKIT_VER/injected-bundle" "$WEBKIT_TMP_DIR/usr/lib64/$WEBKIT_VER/injected-bundle" 2>/dev/null || true
      fi
      WEBKIT_APPIMAGE_FIX="$WEBKIT_TMP_DIR"
    fi
    break
  fi
done

# Mozilla
export MOZ_LEGACY_PROFILES=1 # Prevent per installation profiles

# Execute the application
EXEC=$(grep -e '^Exec=.*' "${HERE}"/*.desktop | head -n 1 | cut -d "=" -f 2- | sed -e 's|%.||g')

# Check if the executable is a script with a shebang pointing to a bundled interpreter
EXEC_PATH=$(command -v ${EXEC%% *} 2>/dev/null || echo "${HERE}/usr/bin/${EXEC%% *}")
if [ -f "$EXEC_PATH" ] && head -1 "$EXEC_PATH" | grep -q '^#!'; then
    SHEBANG_INTERP=$(head -1 "$EXEC_PATH" | sed 's/^#!//' | awk '{print $1}')
    INTERP_NAME=$(basename "$SHEBANG_INTERP")
    # If the shebang interpreter exists in our bundled bin, use it
    if [ -x "${HERE}/usr/bin/$INTERP_NAME" ]; then
        EXEC_ARGS=$(echo "$EXEC" | cut -d' ' -f2-)
        [ "$EXEC_ARGS" = "${EXEC%% *}" ] && EXEC_ARGS=""
        exec "${HERE}/usr/bin/$INTERP_NAME" "$EXEC_PATH" $EXEC_ARGS "$@"
    fi
fi

# WebKitGTK fix: use bwrap to bind-mount our helpers to /usr/libexec
# This is needed because WebKit has hardcoded paths compiled into the library
if [ -n "$WEBKIT_APPIMAGE_FIX" ] && [ -d "$WEBKIT_APPIMAGE_FIX" ] && command -v bwrap >/dev/null 2>&1; then
    # Cleanup on exit
    cleanup_webkit() {
        rm -rf "$WEBKIT_APPIMAGE_FIX" 2>/dev/null
    }
    trap cleanup_webkit EXIT
    
    # Copy existing /usr/libexec contents to our temp dir (if they exist)
    # This ensures we don't break other apps that need /usr/libexec
    if [ -d /usr/libexec ]; then
        for item in /usr/libexec/*; do
            [ -e "$item" ] || continue
            itemname=$(basename "$item")
            # Don't overwrite our WebKit symlinks
            if [ ! -e "$WEBKIT_APPIMAGE_FIX/usr/libexec/$itemname" ]; then
                ln -sf "$item" "$WEBKIT_APPIMAGE_FIX/usr/libexec/$itemname" 2>/dev/null || true
            fi
        done
    fi
    
    # Build bwrap arguments - start with basic bind
    BWRAP_ARGS="--dev-bind / / --bind $WEBKIT_APPIMAGE_FIX/usr/libexec /usr/libexec"
    
    # Add lib64 webkit bind if it exists in our AppImage (for injected bundle)
    # Only do this if the target directory already exists on the system
    if [ -d "$WEBKIT_APPIMAGE_FIX/usr/lib64/$WEBKIT_VER" ] && [ -d "/usr/lib64/$WEBKIT_VER" ]; then
        for item in /usr/lib64/$WEBKIT_VER/*; do
            [ -e "$item" ] || continue
            itemname=$(basename "$item")
            if [ ! -e "$WEBKIT_APPIMAGE_FIX/usr/lib64/$WEBKIT_VER/$itemname" ]; then
                ln -sf "$item" "$WEBKIT_APPIMAGE_FIX/usr/lib64/$WEBKIT_VER/$itemname" 2>/dev/null || true
            fi
        done
        BWRAP_ARGS="$BWRAP_ARGS --bind $WEBKIT_APPIMAGE_FIX/usr/lib64/$WEBKIT_VER /usr/lib64/$WEBKIT_VER"
    fi
    
    # Use bwrap to create mount namespace with merged paths
    exec bwrap \
        $BWRAP_ARGS \
        --setenv HERE "$HERE" \
        --setenv PATH "$PATH" \
        --setenv LD_LIBRARY_PATH "$LD_LIBRARY_PATH" \
        --setenv XDG_DATA_DIRS "$XDG_DATA_DIRS" \
        --setenv GI_TYPELIB_PATH "$GI_TYPELIB_PATH" \
        --setenv GSETTINGS_SCHEMA_DIR "$GSETTINGS_SCHEMA_DIR" \
        --setenv WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS "$WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS" \
        --setenv WEBKIT2_INJECTED_BUNDLE_PATH "$WEBKIT2_INJECTED_BUNDLE_PATH" \
        ${EXEC} "$@"
elif [ -n "$WEBKIT_APPIMAGE_FIX" ]; then
    # Cleanup temp dir if bwrap not available
    rm -rf "$WEBKIT_APPIMAGE_FIX" 2>/dev/null
    echo "Warning: WebKitGTK app detected but 'bwrap' (bubblewrap) is not installed."
    echo "The app may not work correctly. Install bubblewrap: sudo dnf install bubblewrap"
fi

exec ${EXEC} "$@"
