VERSION="1.4.1"

# Initialize variables
DEBUG=false
MINIMAL=true
PKG=""
EXTRA_PKGS=""

# Get host architecture
HOST_ARCH=$(uname -m)

# Function to show help
show_help() {
  echo "Usage: $(basename "$0") [OPTIONS] <package_name_or_rpm>"
  echo ""
  echo "Options:"
  echo "  --help              Show this help message"
  echo "  --version           Show version information"
  echo "  --debug             Keep build directory (.AppDir) after successful build"
  echo "  --full              Bundle all dependencies (default: only bundle deps not on host)"
  echo "  --extra <pkg,...>   Additional packages to bundle (comma-separated, mutually exclusive with --full)"
  echo ""
  echo "Example:"
  echo "  $(basename "$0") --extra ffmpeg-libs,libva nextcloud-client"
  echo ""
  exit 0
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --help)
      show_help
      ;;
    --version)
      echo "version $VERSION"
      exit 0
      ;;
    --debug)
      DEBUG=true
      shift
      ;;
    --full)
      if [ -n "$EXTRA_PKGS" ]; then
        echo "Error: --full and --extra are mutually exclusive"
        exit 1
      fi
      MINIMAL=false
      shift
      ;;
    --extra)
      if [ "$MINIMAL" = false ]; then
        echo "Error: --full and --extra are mutually exclusive"
        exit 1
      fi
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
        echo "Error: --extra requires a comma-separated list of packages"
        exit 1
      fi
      EXTRA_PKGS="$2"
      shift 2
      ;;
    -*)
      echo "Error: Unknown option $1"
      exit 1
      ;;
    *)
      PKG="$1"
      shift
      ;;
  esac
done

# Check if the package argument is provided
if [ -z "$PKG" ]; then
  echo "Error: Package name or RPM file argument is missing."
  echo "Use --help for usage information."
  exit 1
fi

APPDIR="$PKG.AppDir"

# Function to detect Linux distribution
detect_distro() {
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    case "$ID" in
      fedora|rhel|centos|rocky|alma|nobara)
        echo "rhel"
        ;;
      debian|ubuntu|linuxmint|pop|elementary|zorin|kali)
        echo "debian"
        ;;
      arch|manjaro|endeavouros|garuda|artix)
        echo "arch"
        ;;
      opensuse*|suse*)
        echo "suse"
        ;;
      *)
        # Check ID_LIKE for derivatives
        case "$ID_LIKE" in
          *fedora*|*rhel*)
            echo "rhel"
            ;;
          *debian*|*ubuntu*)
            echo "debian"
            ;;
          *arch*)
            echo "arch"
            ;;
          *suse*)
            echo "suse"
            ;;
          *)
            echo "unknown"
            ;;
        esac
        ;;
    esac
  else
    echo "unknown"
  fi
}

# Function to install toolbox
install_toolbox() {
  local distro="$1"
  echo ""
  echo "Toolbox is required but not installed."
  echo "Detected distribution family: $distro"
  echo ""
  
  case "$distro" in
    rhel)
      echo "To install toolbox on Fedora/RHEL-based systems, run:"
      echo "  sudo dnf install toolbox"
      ;;
    debian)
      echo "To install toolbox on Debian/Ubuntu-based systems, run:"
      echo "  sudo apt install podman-toolbox"
      echo ""
      echo "Note: You may need to enable the backports repository on older Debian versions."
      ;;
    arch)
      echo "To install toolbox on Arch-based systems, run:"
      echo "  sudo pacman -S toolbox"
      ;;
    suse)
      echo "To install toolbox on openSUSE, run:"
      echo "  sudo zypper install toolbox"
      ;;
    *)
      echo "Could not detect your distribution."
      echo "Please install 'toolbox' using your package manager."
      echo "Toolbox requires podman to be installed as well."
      ;;
  esac
  
  echo ""
  read -p "Would you like to attempt automatic installation? [y/N] " -n 1 -r
  echo ""
  
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    case "$distro" in
      rhel)
        sudo dnf install -y toolbox || { echo "Error: Failed to install toolbox"; exit 1; }
        ;;
      debian)
        sudo apt update && sudo apt install -y podman-toolbox || { echo "Error: Failed to install toolbox"; exit 1; }
        ;;
      arch)
        sudo pacman -S --noconfirm toolbox || { echo "Error: Failed to install toolbox"; exit 1; }
        ;;
      suse)
        sudo zypper install -y toolbox || { echo "Error: Failed to install toolbox"; exit 1; }
        ;;
      *)
        echo "Error: Cannot auto-install on unknown distribution"
        exit 1
        ;;
    esac
    echo "Toolbox installed successfully!"
  else
    echo "Please install toolbox manually and run this script again."
    exit 1
  fi
}

# Fedora version to glibc version mapping
# This maps Fedora releases to their glibc versions for compatibility checking
# Format: fedora_version:glibc_major.glibc_minor
FEDORA_GLIBC_MAP="
44:2.43
43:2.42
42:2.41
41:2.40
40:2.39
39:2.38
38:2.37
37:2.36
"

# Function to get host glibc version
get_host_glibc_version() {
  # Try ldd --version first
  local glibc_version
  glibc_version=$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
  
  if [ -n "$glibc_version" ]; then
    echo "$glibc_version"
    return
  fi
  
  # Fallback: check libc.so.6 directly
  glibc_version=$(strings /lib/x86_64-linux-gnu/libc.so.6 2>/dev/null | grep -oE 'GLIBC_[0-9]+\.[0-9]+' | sort -V | tail -1 | sed 's/GLIBC_//')
  
  if [ -n "$glibc_version" ]; then
    echo "$glibc_version"
    return
  fi
  
  # Default fallback - assume relatively recent
  echo "2.38"
}

# Function to compare version strings (returns 0 if v1 <= v2)
version_lte() {
  [ "$1" = "$(echo -e "$1\n$2" | sort -V | head -n1)" ]
}

# Function to get best compatible Fedora version for host glibc
get_compatible_fedora_release() {
  local host_glibc="$1"
  local best_fedora=""
  local best_glibc=""
  
  # Parse the mapping and find the highest Fedora version with glibc <= host_glibc
  while IFS=: read -r fedora_ver glibc_ver; do
    # Skip empty lines
    [ -z "$fedora_ver" ] && continue
    
    # Check if this Fedora's glibc is compatible (less than or equal to host)
    if version_lte "$glibc_ver" "$host_glibc"; then
      # Take the highest compatible Fedora version
      if [ -z "$best_fedora" ] || [ "$fedora_ver" -gt "$best_fedora" ]; then
        best_fedora="$fedora_ver"
        best_glibc="$glibc_ver"
      fi
    fi
  done <<< "$FEDORA_GLIBC_MAP"
  
  if [ -n "$best_fedora" ]; then
    echo "$best_fedora"
  else
    # Fallback to oldest supported if nothing matches
    echo "37"
  fi
}

# Function to create toolbox container
create_toolbox_container() {
  echo ""
  echo "No Fedora toolbox container found."
  
  # Get host glibc version and find compatible Fedora
  local host_glibc
  host_glibc=$(get_host_glibc_version)
  echo "Host glibc version: $host_glibc"
  
  local fedora_release
  fedora_release=$(get_compatible_fedora_release "$host_glibc")
  
  # Get the glibc version for this Fedora release
  local fedora_glibc
  fedora_glibc=$(echo "$FEDORA_GLIBC_MAP" | grep "^$fedora_release:" | cut -d: -f2)
  
  echo "Selected Fedora $fedora_release (glibc $fedora_glibc) for compatibility"
  
  read -p "Would you like to create a Fedora $fedora_release toolbox container? [Y/n] " -n 1 -r
  echo ""
  
  if [[ ! $REPLY =~ ^[Nn]$ ]]; then
    echo "Creating Fedora $fedora_release toolbox container..."
    if toolbox create --distro fedora --release "$fedora_release" -y; then
      echo "Toolbox container created successfully!"
    else
      echo "Error: Failed to create toolbox container"
      exit 1
    fi
  else
    echo "A Fedora toolbox container is required to run this script."
    echo "Create one manually with: toolbox create --distro fedora --release <version>"
    exit 1
  fi
}

# Function to find the best compatible Fedora container from existing ones
find_compatible_container() {
  local host_glibc="$1"
  local best_container=""
  local best_version=0
  
  # Get all Fedora toolbox containers
  while read -r container; do
    [ -z "$container" ] && continue
    
    # Extract version number from container name (e.g., fedora-toolbox-41 -> 41)
    local version
    version=$(echo "$container" | grep -oE '[0-9]+$')
    [ -z "$version" ] && continue
    
    # Get glibc version for this Fedora release
    local container_glibc
    container_glibc=$(echo "$FEDORA_GLIBC_MAP" | grep "^$version:" | cut -d: -f2)
    if [ -z "$container_glibc" ]; then
      local max_known
      max_known=$(echo "$FEDORA_GLIBC_MAP" | grep -oE '^[0-9]+' | sort -n | tail -1)
      if [ "$version" -gt "$max_known" ] 2>/dev/null; then
        if [ "$version" -gt "$best_version" ]; then
          best_version="$version"
          best_container="$container"
        fi
      fi
      continue
    fi

    # Check if this container's glibc is compatible
    if version_lte "$container_glibc" "$host_glibc"; then
      # Take the highest compatible version
      if [ "$version" -gt "$best_version" ]; then
        best_version="$version"
        best_container="$container"
      fi
    fi
  done <<< "$(toolbox list -c 2>/dev/null | grep -oE 'fedora-toolbox-[0-9]+')"
  
  echo "$best_container"
}

# Always use toolbox for consistent environment
# Check if toolbox is installed
if ! command -v toolbox >/dev/null 2>&1; then
  distro=$(detect_distro)
  install_toolbox "$distro"
fi

# Get host glibc version for compatibility checking
HOST_GLIBC=$(get_host_glibc_version)

# Check if a compatible Fedora toolbox container exists
FEDORA_CONTAINER=$(find_compatible_container "$HOST_GLIBC")

if [ -z "$FEDORA_CONTAINER" ]; then
  # Check if any Fedora container exists but is incompatible
  ANY_CONTAINER=$(toolbox list -c 2>/dev/null | grep -oE "fedora-toolbox-[0-9]+" | head -n 1)
  if [ -n "$ANY_CONTAINER" ]; then
    container_ver=$(echo "$ANY_CONTAINER" | grep -oE '[0-9]+$')
    container_glibc=$(echo "$FEDORA_GLIBC_MAP" | grep "^$container_ver:" | cut -d: -f2)
    echo "Warning: Existing container $ANY_CONTAINER (glibc $container_glibc) is incompatible with host glibc $HOST_GLIBC"
    echo "A compatible container is needed for AppImage to work on this system."
  fi
  create_toolbox_container
  FEDORA_CONTAINER=$(find_compatible_container "$HOST_GLIBC")
  
  # If still no compatible container, fall back to any Fedora container
  if [ -z "$FEDORA_CONTAINER" ]; then
    FEDORA_CONTAINER=$(toolbox list -c 2>/dev/null | grep -oE "fedora-toolbox-[0-9]+" | head -n 1)
  fi
fi

TOOLBOX_RUN="toolbox run --container $FEDORA_CONTAINER"

# Get script directory for resources
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load excludelist (packages that should never be bundled)
EXCLUDELIST=""
if [ -f "$SCRIPT_DIR/resources/excludelist" ]; then
  # Read excludelist, removing comments and empty lines
  EXCLUDELIST=$(grep -v '^#' "$SCRIPT_DIR/resources/excludelist" | grep -v '^$' | sort -u)
fi

# Preparing
# Make AppDir folder
if [ -d "$APPDIR" ]; then
  rm -rf "$APPDIR"
fi
mkdir "$APPDIR"

# Make tmp folder
if [ -d "tmp" ]; then
  rm -rf "tmp"
fi
mkdir "tmp"

# Build list of installed packages on host for minimal mode
HOST_INSTALLED_PKGS=""
if [ "$MINIMAL" = true ]; then
  echo "Minimal mode: checking installed packages on host..."
  HOST_INSTALLED_PKGS=$(rpm -qa --qf "%{NAME}\n" 2>/dev/null | sort -u)
fi

# Function to extract package name from RPM filename or URL
extract_pkg_name() {
  local input="$1"
  # Get basename if it's a URL or path
  local filename
  filename=$(basename "$input")
  # Remove .rpm extension and extract package name (handle epoch in filename)
  # Pattern: name-[epoch:]version-release.arch.rpm
  echo "$filename" | sed 's/\.rpm$//' | sed 's/\.[^.]*$//' | sed 's/-[0-9][^-]*-[^-]*$//'
}

# Resolve dependencies and get URLs without downloading
echo "Resolving dependencies for $HOST_ARCH architecture..."
LOCAL_RPM=""
LOCAL_ONLY=false
if [ -f "$PKG" ]; then
  echo "Local RPM detected: $PKG"
  LOCAL_RPM="$PKG"
  # Get package name from RPM file
  PKG_NAME=$($TOOLBOX_RUN rpm -qp --qf "%{NAME}" "$PKG" 2>/dev/null)
  ALL_URLS=$($TOOLBOX_RUN dnf5 download --resolve --url --arch="$HOST_ARCH" --arch=noarch "$PKG_NAME" 2>/dev/null)
  
  # If package not in repos, use local RPM only (common for proprietary apps like Slack)
  if [ -z "$ALL_URLS" ]; then
    echo "Package not found in repositories, using local RPM only..."
    LOCAL_ONLY=true
  fi
else
  PKG_NAME="$PKG"
  ALL_URLS=$($TOOLBOX_RUN dnf5 download --resolve --url --arch="$HOST_ARCH" --arch=noarch "$PKG" 2>/dev/null)
fi

if [ -z "$ALL_URLS" ] && [ "$LOCAL_ONLY" = false ]; then
  echo "Error: Package '$PKG' not found or failed to resolve dependencies"
  rm -rf tmp "$APPDIR"
  exit 1
fi

# Handle local-only mode (no repo dependencies to resolve)
if [ "$LOCAL_ONLY" = true ]; then
  echo "Using local RPM only (no repository dependencies)"
  cp "$LOCAL_RPM" tmp/
  echo "Added local RPM: $(basename "$LOCAL_RPM")"
else
  # Normal mode: process URLs and download dependencies
  total_count=$(echo "$ALL_URLS" | wc -l)
  echo "Resolved $total_count packages"

# Filter URLs based on host packages and excludelist
FILTERED_URLS=""
skipped_host=0
skipped_exclude=0
skipped_main=0

while IFS= read -r url; do
  [ -z "$url" ] && continue
  pkg_name=$(extract_pkg_name "$url")
  
  # Always include the main package (will be replaced with local if provided)
  if [ "$pkg_name" = "$PKG_NAME" ]; then
    if [ -n "$LOCAL_RPM" ]; then
      ((skipped_main++))
      continue
    fi
    FILTERED_URLS="$FILTERED_URLS"$'\n'"$url"
    continue
  fi
  
  # Check excludelist
  if [ -n "$EXCLUDELIST" ] && echo "$EXCLUDELIST" | grep -qx "$pkg_name"; then
    ((skipped_exclude++))
    continue
  fi
  
  # Check host packages (minimal mode)
  if [ "$MINIMAL" = true ] && [ -n "$HOST_INSTALLED_PKGS" ]; then
    if echo "$HOST_INSTALLED_PKGS" | grep -qx "$pkg_name"; then
      ((skipped_host++))
      continue
    fi
  fi
  
  FILTERED_URLS="$FILTERED_URLS"$'\n'"$url"
done <<< "$ALL_URLS"

# Remove leading newline
FILTERED_URLS=$(echo "$FILTERED_URLS" | sed '/^$/d')

if [ "$MINIMAL" = true ]; then
  echo "Skipped $skipped_host packages already on host"
fi
if [ -n "$EXCLUDELIST" ]; then
  echo "Skipped $skipped_exclude packages from excludelist"
fi

download_count=$(echo "$FILTERED_URLS" | grep -c . || echo 0)
echo "Downloading $download_count packages..."

# Download filtered packages
if [ -n "$FILTERED_URLS" ]; then
  while IFS= read -r url; do
    [ -z "$url" ] && continue
    filename=$(basename "$url")
    echo "Downloading $filename"
    if ! curl -sL -o "tmp/$filename" "$url"; then
      echo "Warning: Failed to download $url"
    fi
  done <<< "$FILTERED_URLS"
fi

# Copy local RPM to tmp if provided
if [ -n "$LOCAL_RPM" ]; then
  cp "$LOCAL_RPM" tmp/
  echo "Added local RPM: $(basename "$LOCAL_RPM")"
fi

# Download extra packages if specified (--extra option)
if [ -n "$EXTRA_PKGS" ]; then
  echo "Downloading extra packages: $EXTRA_PKGS"
  # Convert comma-separated list to space-separated
  EXTRA_PKG_LIST=$(echo "$EXTRA_PKGS" | tr ',' ' ')
  for extra_pkg in $EXTRA_PKG_LIST; do
    echo "Resolving: $extra_pkg"
    EXTRA_URLS=$($TOOLBOX_RUN dnf5 download --resolve --url --arch="$HOST_ARCH" --arch=noarch "$extra_pkg" 2>/dev/null)
    if [ -z "$EXTRA_URLS" ]; then
      echo "Warning: Could not resolve package '$extra_pkg'"
      continue
    fi
    while IFS= read -r url; do
      [ -z "$url" ] && continue
      filename=$(basename "$url")
      # Skip if already downloaded
      if [ -f "tmp/$filename" ]; then
        continue
      fi
      echo "Downloading $filename"
      if ! curl -sL -o "tmp/$filename" "$url"; then
        echo "Warning: Failed to download $url"
      fi
    done <<< "$EXTRA_URLS"
  done
fi

fi  # End of LOCAL_ONLY else block

# Check if any RPMs were downloaded
if ! ls tmp/*.rpm >/dev/null 2>&1; then
  echo "Error: No RPM packages were downloaded"
  rm -rf tmp "$APPDIR"
  exit 1
fi

# Loop through all RPM files in tmp folder
# Extract the main package last so its files take precedence over dependencies
MAIN_RPM=""
for rpm_file in tmp/*.rpm; do
  rpm_name=$($TOOLBOX_RUN rpm -qp --qf "%{NAME}" "$rpm_file" 2>/dev/null)
  if [ "$rpm_name" = "$PKG_NAME" ]; then
    MAIN_RPM="$rpm_file"
    continue
  fi
  echo "Extracting $rpm_file to AppDir"
  $TOOLBOX_RUN rpm2cpio "$rpm_file" | (cd "$APPDIR" && $TOOLBOX_RUN cpio -idm)
done

# Extract main package last
if [ -n "$MAIN_RPM" ]; then
  echo "Extracting $MAIN_RPM to AppDir (main package)"
  $TOOLBOX_RUN rpm2cpio "$MAIN_RPM" | (cd "$APPDIR" && $TOOLBOX_RUN cpio -idm)
fi

# Remove temporary folder
rm -rf tmp

#
# Fix broken absolute symlinks - convert to relative paths within AppDir
# This is critical for apps like gnome-maps where /usr/bin/gnome-maps -> /usr/share/gnome-maps/org.gnome.Maps
#
echo "Fixing absolute symlinks..."
fixed_symlinks=0
while IFS= read -r symlink; do
    target=$(readlink "$symlink")
    # Only process absolute symlinks (starting with /)
    if [ "${target#/}" != "$target" ]; then
        # Check if target exists in AppDir
        if [ -e "$APPDIR$target" ]; then
            # Calculate relative path from symlink location to target
            symlink_dir=$(dirname "$symlink")
            # Remove APPDIR prefix from both paths
            symlink_rel="${symlink_dir#$APPDIR}"
            target_rel="$target"
            
            # Count directory depth of symlink location to build relative path
            depth=$(echo "$symlink_rel" | tr -cd '/' | wc -c)
            rel_prefix=""
            i=0
            while [ $i -lt $depth ]; do
                rel_prefix="../$rel_prefix"
                i=$((i + 1))
            done
            
            # Build new relative target (remove leading / from target)
            new_target="${rel_prefix}${target#/}"
            
            # Remove old symlink and create new relative one
            rm "$symlink"
            ln -s "$new_target" "$symlink"
            ((fixed_symlinks++))
        fi
    fi
done < <(find "$APPDIR" -type l 2>/dev/null)
[ $fixed_symlinks -gt 0 ] && echo "Fixed $fixed_symlinks absolute symlinks"

#
# Bundle known dlopen'd dependencies that aren't declared in RPM requires
# These are libraries loaded at runtime via dlopen() and missed by dependency resolution
#
DLOPEN_DEPS=""

# Qt6 apps need libb2 (BLAKE2 hashing - dlopen'd by Qt6Core)
if find "$APPDIR" -name "libQt6Core.so*" -print -quit 2>/dev/null | grep -q .; then
    echo "Qt6 detected, adding known dlopen'd dependencies..."
    DLOPEN_DEPS="$DLOPEN_DEPS libb2"
fi

# Add more framework-specific dlopen'd deps here as discovered

if [ -n "$DLOPEN_DEPS" ]; then
    echo "Fetching dlopen'd dependencies: $DLOPEN_DEPS"
    mkdir -p tmp
    
    for pkg in $DLOPEN_DEPS; do
        # Skip if already in AppDir
        if find "$APPDIR" -name "${pkg}.so*" -print -quit 2>/dev/null | grep -q .; then
            echo "  $pkg already bundled"
            continue
        fi
        
        echo "  Downloading: $pkg"
        pkg_url=$($TOOLBOX_RUN dnf5 download --url --arch="$HOST_ARCH" --arch=noarch "$pkg" 2>/dev/null | head -1)
        if [ -n "$pkg_url" ]; then
            filename=$(basename "$pkg_url")
            curl -sL -o "tmp/$filename" "$pkg_url"
            echo "  Extracting: $filename"
            $TOOLBOX_RUN rpm2cpio "tmp/$filename" | (cd "$APPDIR" && $TOOLBOX_RUN cpio -idm)
        else
            echo "  Warning: Could not find package for $pkg"
        fi
    done
    
    rm -rf tmp
fi

#
# Finalizing AppDir folder by adding required files
#

# Find metainfo early so it can help generate a fallback desktop entry
metainfo_file=$(find "$APPDIR/usr/share/metainfo" -name "*.xml" -print -quit 2>/dev/null)

# Helper: extract first matching value from metainfo
get_metainfo_value() {
  local file="$1"
  local tag="$2"
  [ -n "$file" ] || return 1
  grep -m 1 -E "<${tag}([^>]*)>" "$file" 2>/dev/null | sed -n "s/.*<${tag}[^>]*>\([^<]*\)<\/${tag}>.*/\1/p"
}

# Helper: extract icon value from metainfo (stock or local)
get_metainfo_icon() {
  local file="$1"
  [ -n "$file" ] || return 1
  grep -m 1 -E "<icon[^>]*>" "$file" 2>/dev/null | sed -n "s/.*<icon[^>]*>\([^<]*\)<\/icon>.*/\1/p"
}

# Helper: find the best exec candidate in the AppDir
find_exec_candidate() {
  local candidates=()
  local meta_id
  local meta_name
  meta_id=$(get_metainfo_value "$metainfo_file" "id")
  meta_name=$(get_metainfo_value "$metainfo_file" "name")

  [ -n "$PKG_NAME" ] && candidates+=("$PKG_NAME")
  [ -n "$meta_id" ] && candidates+=("$meta_id" "${meta_id##*.}")
  [ -n "$meta_name" ] && candidates+=("$meta_name")

  for cand in "${candidates[@]}"; do
    for dir in "$APPDIR/usr/bin" "$APPDIR/usr/sbin" "$APPDIR/usr/libexec"; do
      if [ -x "$dir/$cand" ]; then
        basename "$dir/$cand"
        return 0
      fi
    done
  done

  local execs=()
  for dir in "$APPDIR/usr/bin" "$APPDIR/usr/sbin" "$APPDIR/usr/libexec"; do
    [ -d "$dir" ] || continue
    while IFS= read -r exec_path; do
      execs+=("$exec_path")
    done < <(find "$dir" -maxdepth 1 -type f -perm -111 2>/dev/null | sort)
  done

  if [ ${#execs[@]} -eq 1 ]; then
    basename "${execs[0]}"
    return 0
  fi

  if [ ${#execs[@]} -gt 0 ]; then
    basename "${execs[0]}"
    return 0
  fi

  return 1
}

# Helper: create a fallback desktop file using metadata and inferred exec
create_fallback_desktop() {
  local exec_name
  local app_name
  local app_comment
  local app_icon
  exec_name=$(find_exec_candidate) || return 1
  app_name=$(get_metainfo_value "$metainfo_file" "name")
  app_comment=$(get_metainfo_value "$metainfo_file" "summary")
  app_icon=$(get_metainfo_icon "$metainfo_file")

  [ -n "$app_name" ] || app_name="$PKG_NAME"
  [ -n "$app_comment" ] || app_comment="$app_name"
  [ -n "$app_icon" ] || app_icon="terminal"

  cat > "$APPDIR/${PKG_NAME}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$app_name
Comment=$app_comment
Exec=$exec_name
Icon=$app_icon
Terminal=true
Categories=Utility;
EOF

  echo "Created fallback desktop file: ${PKG_NAME}.desktop"
  return 0
}

# Adding .desktop file
# Strategy: 1) Match by package name, 2) Filter out NoDisplay=true, 3) Fallback to first visible
if [ -d "$APPDIR/usr/share/applications/" ]; then
    desktop_file=""
    
    # Convert package name to search pattern (e.g., gnome-calendar -> *gnome*calendar* or *Calendar*)
    # Handle common naming: gnome-calendar -> org.gnome.Calendar.desktop
    pkg_pattern=$(echo "$PKG_NAME" | sed 's/-/.*/')
    
    # Strategy 1: Try to find desktop file matching package name (case-insensitive)
    for df in "$APPDIR/usr/share/applications/"*.desktop; do
        [ -f "$df" ] || continue
        df_basename=$(basename "$df")
        # Check if filename matches package pattern (case-insensitive)
        if echo "$df_basename" | grep -iq "$pkg_pattern"; then
            # Skip if NoDisplay=true
            if ! grep -q "^NoDisplay=true" "$df"; then
                desktop_file="$df"
                echo "Found desktop file matching package name: $df_basename"
                break
            fi
        fi
    done
    
    # Strategy 2: If no match, find first desktop file without NoDisplay=true
    if [ -z "$desktop_file" ]; then
        for df in "$APPDIR/usr/share/applications/"*.desktop; do
            [ -f "$df" ] || continue
            if ! grep -q "^NoDisplay=true" "$df"; then
                desktop_file="$df"
                echo "Using first visible desktop file: $(basename "$df")"
                break
            fi
        done
    fi
    
    # Strategy 3: Last resort - use any desktop file
    if [ -z "$desktop_file" ]; then
        desktop_file=$(find "$APPDIR/usr/share/applications/" -name "*.desktop" -print -quit)
        if [ -n "$desktop_file" ]; then
            echo "Warning: All desktop files have NoDisplay=true, using: $(basename "$desktop_file")"
        fi
    fi
    
    if [ -n "$desktop_file" ]; then
        symlink_file=$(basename "$desktop_file")
        desktop_file=${desktop_file#"$APPDIR"/}
        ln -s "$desktop_file" "$APPDIR/$symlink_file"
        echo "Created symlink for $symlink_file in AppDir"
    else
        echo "No .desktop file found in AppDir/usr/share/applications/"
    fi
else
    echo "AppDir/usr/share/applications/ directory does not exist"
fi

# Adding generic desktop file if original does not exist
if [ ! "$(find "$APPDIR" -maxdepth 1 -name '*.desktop' -print -quit)" ]; then
  if ! create_fallback_desktop; then
    # Copy the file to the AppDir
    cp -n "resources/terminal.desktop" "${APPDIR}/"
    echo "Warning: copied generic desktop file 'terminal.desktop' to AppDir.Please edit correct values."
  fi
fi

# Adding icon file in AppDir
# Find icon by exact name from desktop file - no fallbacks
desktop_file_path=$(find "$APPDIR" -maxdepth 1 -name "*.desktop" -print -quit)
if [ -n "$desktop_file_path" ]; then
    icon_name=$(grep "^Icon=" "$desktop_file_path" | head -n 1 | cut -d "=" -f 2)
    if [ -n "$icon_name" ]; then
        # If it's a path, get the basename
        icon_base=$(basename "$icon_name")
        # Remove only actual image extensions (.png, .svg, .xpm), not dots in icon names like org.gnome.Epiphany
        icon_no_ext=$(echo "$icon_base" | sed 's/\.\(png\|svg\|xpm\|ico\)$//')
        
        # Search for the icon by exact name in standard locations
        found_icon=""
        
        # Build list of search directories that exist
        search_dirs=""
        for dir in "$APPDIR/usr/share/icons" "$APPDIR/usr/share/pixmaps"; do
            [ -d "$dir" ] && search_dirs="$search_dirs $dir"
        done
        
        if [ -n "$search_dirs" ]; then
            # Find exact match by icon name (prefer SVG over PNG)
            found_icon=$(find $search_dirs -type f -name "${icon_no_ext}.svg" 2>/dev/null | head -n 1)
            
            # Try PNG if no SVG found (prefer larger sizes)
            if [ -z "$found_icon" ]; then
                for size in 256x256 128x128 96x96 64x64 48x48 scalable; do
                    found_icon=$(find $search_dirs -type f -path "*/${size}/*" -name "${icon_no_ext}.png" 2>/dev/null | head -n 1)
                    [ -n "$found_icon" ] && break
                done
            fi
            
            # Try any PNG matching icon name
            if [ -z "$found_icon" ]; then
                found_icon=$(find $search_dirs -type f -name "${icon_no_ext}.png" 2>/dev/null | head -n 1)
            fi
        fi
        
        # If not found in standard locations, search entire AppDir (some apps store icons in non-standard places)
        if [ -z "$found_icon" ]; then
            found_icon=$(find "$APPDIR" -type f -name "${icon_no_ext}.svg" 2>/dev/null | head -n 1)
        fi
        if [ -z "$found_icon" ]; then
            found_icon=$(find "$APPDIR" -type f -name "${icon_no_ext}.png" 2>/dev/null | head -n 1)
        fi
        
        if [ -n "$found_icon" ]; then
            symlink_name=$(basename "$found_icon")
            # Copy icon to AppDir root (better compatibility with thumbnailers)
            cp "$found_icon" "$APPDIR/$symlink_name"
            ln -s "$symlink_name" "$APPDIR/.DirIcon"
            echo "Icon copied to AppDir root: $symlink_name"
            
            # Fix desktop file if it uses absolute path for Icon or has extension
            real_desktop_file=$(readlink -f "$desktop_file_path")
            sed -i "s|^Icon[[:space:]]*=.*|Icon=$icon_no_ext|" "$real_desktop_file"
            echo "Fixed Icon path in desktop file to $icon_no_ext"
            
            # Fix Exec path in desktop file
            # Standard bin directories
            sed -i 's|^Exec=[[:space:]]*/usr/bin/|Exec=|' "$real_desktop_file"
            sed -i 's|^Exec=[[:space:]]*/usr/sbin/|Exec=|' "$real_desktop_file"
            sed -i 's|^Exec=[[:space:]]*/bin/|Exec=|' "$real_desktop_file"
            sed -i 's|^Exec=[[:space:]]*/sbin/|Exec=|' "$real_desktop_file"
            # Electron/VSCode-style apps that install in /usr/share/appname/
            # Match pattern: /usr/share/something/executable -> executable
            sed -i 's|^Exec=[[:space:]]*/usr/share/[^/]*/|Exec=|' "$real_desktop_file"
            # libexec paths
            sed -i 's|^Exec=[[:space:]]*/usr/libexec/|Exec=|' "$real_desktop_file"
            echo "Fixed Exec path in desktop file"
        else
          # Fallback: use bundled terminal.svg if we are using the generic desktop file
          if [ "$icon_no_ext" = "terminal" ] && [ -f "$SCRIPT_DIR/resources/terminal.svg" ]; then
            symlink_name="terminal.svg"
            cp "$SCRIPT_DIR/resources/terminal.svg" "$APPDIR/$symlink_name"
            ln -s "$symlink_name" "$APPDIR/.DirIcon"
            echo "Icon copied to AppDir root: $symlink_name"
            real_desktop_file=$(readlink -f "$desktop_file_path")
            sed -i "s|^Icon[[:space:]]*=.*|Icon=terminal|" "$real_desktop_file"
            echo "Fixed Icon path in desktop file to terminal"
          else
            echo "Error: Icon '$icon_no_ext' not found in AppDir icon directories"
            echo "Searched in: $search_dirs"
            rm -rf "$APPDIR"
            exit 1
          fi
        fi
    else
        echo "Error: No Icon= entry found in desktop file"
        rm -rf "$APPDIR"
        exit 1
    fi
else
    echo "Error: No .desktop file found in AppDir root"
    rm -rf "$APPDIR"
    exit 1
fi

# Fix DBus-activated apps (gapplication launch) - replace with actual binary
if [ -n "$desktop_file_path" ]; then
    real_desktop_file=$(readlink -f "$desktop_file_path")
    exec_line=$(grep "^Exec=" "$real_desktop_file" | head -n 1)
    
    # Check if it uses gapplication launch
    if echo "$exec_line" | grep -q "gapplication launch"; then
        app_id=$(echo "$exec_line" | sed 's/.*gapplication launch //' | awk '{print $1}')
        echo "DBus app detected: $app_id"
        
        # Try to find the actual binary
        actual_binary=""
        # Check common locations for the binary
        for bin_path in "$APPDIR/usr/bin/$PKG_NAME" "$APPDIR/usr/bin/$app_id" "$APPDIR/usr/share/$app_id/$app_id"; do
            if [ -f "$bin_path" ] || [ -L "$bin_path" ]; then
                actual_binary=$(basename "$bin_path")
                echo "Found actual binary: $actual_binary"
                break
            fi
        done
        
        if [ -n "$actual_binary" ]; then
            # Replace gapplication launch with actual binary
            sed -i "s|^Exec=gapplication launch [^ ]*|Exec=$actual_binary|" "$real_desktop_file"
            echo "Fixed Exec to use $actual_binary instead of gapplication launch"
        fi
        
        # Remove DBusActivatable=true as it doesn't work in AppImage
        sed -i '/^DBusActivatable=true/d' "$real_desktop_file"
        echo "Removed DBusActivatable=true from desktop file"
    fi
fi

# Adding metadata from metainfo.xml if it exists
if [ -n "$metainfo_file" ] && [ -n "$desktop_file_path" ]; then
    echo "Metainfo file found: $metainfo_file"
    real_desktop_file=$(readlink -f "$desktop_file_path")
    
    # 1. Extract version from <releases> section (first/latest release)
    # Only add if X-AppImage-Version is not already in desktop file
    if ! grep -q "^X-AppImage-Version=" "$real_desktop_file"; then
        version=$(grep -m 1 '<release[^>]*version=' "$metainfo_file" | sed -n 's/.*version="\([^"]*\)".*/\1/p')
        if [ -n "$version" ]; then
            echo "X-AppImage-Version=$version" >> "$real_desktop_file"
            echo "Added X-AppImage-Version=$version to desktop file"
        fi
    else
        echo "X-AppImage-Version already present in desktop file"
    fi
    
    # 2. Extract description (first <p> tag content)
    description=$(grep -m 1 '<p>' "$metainfo_file" | sed -n 's/.*<p>\([^<]*\)<\/p>.*/\1/p')
    if [ -n "$description" ]; then
        sed -i '/^Comment=/d' "$real_desktop_file"
        if grep -q "^\[Desktop Entry\]" "$real_desktop_file"; then
            sed -i "/^\[Desktop Entry\]/a Comment=$description" "$real_desktop_file"
        else
            echo "Comment=$description" >> "$real_desktop_file"
        fi
        echo "Added Comment to desktop file"
    fi
    
    # 3. Extract homepage
    homepage=$(grep -m 1 '<url type="homepage">' "$metainfo_file" | sed -n 's/.*<url type="homepage">\([^<]*\)<\/url>.*/\1/p')
    if [ -n "$homepage" ]; then
        sed -i '/^X-AppImage-Homepage=/d' "$real_desktop_file"
        echo "X-AppImage-Homepage=$homepage" >> "$real_desktop_file"
        echo "Added X-AppImage-Homepage=$homepage to desktop file"
    fi
fi

# Compile GSettings schemas if any exist
if [ -d "$APPDIR/usr/share/glib-2.0/schemas" ]; then
    schema_files=$(find "$APPDIR/usr/share/glib-2.0/schemas" -name "*.gschema.xml" 2>/dev/null)
    if [ -n "$schema_files" ]; then
        echo "Compiling GSettings schemas..."
        if $TOOLBOX_RUN glib-compile-schemas "$APPDIR/usr/share/glib-2.0/schemas"; then
            echo "GSettings schemas compiled successfully"
        else
            echo "Warning: Failed to compile GSettings schemas"
        fi
    fi
fi

# Apply app-specific fixes (GJS apps, GIMP, etc.)
if [ -f "$SCRIPT_DIR/resources/app-fixes.sh" ]; then
    source "$SCRIPT_DIR/resources/app-fixes.sh"
    apply_app_fixes "$APPDIR" "$TOOLBOX_RUN"
fi

# Generate lib.path file for optimized library loading
# This lists all directories containing shared libraries, relative to AppDir root
echo "Generating lib.path for optimized library loading..."
LIB_PATH_FILE="$APPDIR/lib.path"
> "$LIB_PATH_FILE"  # Clear/create file

# Find all directories containing .so files and write relative paths
for libdir in $(find "$APPDIR/usr/lib" "$APPDIR/usr/lib64" "$APPDIR/lib" "$APPDIR/lib64" -name "*.so*" -type f 2>/dev/null | xargs -r dirname | sort -u); do
    # Convert to relative path from AppDir root (with + prefix like sharun)
    relpath="${libdir#$APPDIR}"
    echo "+$relpath" >> "$LIB_PATH_FILE"
done
echo "Generated lib.path with $(wc -l < "$LIB_PATH_FILE") library directories"

cp -n resources/AppRun "$APPDIR"
chmod +x "$APPDIR/AppRun"

# Packaging: Use uruntime + dwarfs (FUSE-less AppImage)
echo "Generating AppImage..."
# Determine output filename
ARCH=$(uname -m)
OUTPUT_APPIMAGE="${PKG_NAME}-${ARCH}.AppImage"

# Remove existing AppImage with same name if it exists
if [ -f "$OUTPUT_APPIMAGE" ]; then
  rm "$OUTPUT_APPIMAGE"
fi

# Check for uruntime - download if not available
URUNTIME_URL="https://github.com/VHSgunzo/uruntime/releases/latest/download/uruntime-appimage-dwarfs-${ARCH}"
URUNTIME_PATH="$SCRIPT_DIR/resources/uruntime-${ARCH}"

if [ ! -f "$URUNTIME_PATH" ]; then
  echo "Downloading uruntime..."
  if ! curl -L -o "$URUNTIME_PATH" "$URUNTIME_URL" 2>/dev/null; then
    echo "Error: Failed to download uruntime from $URUNTIME_URL"
    exit 1
  fi
  chmod +x "$URUNTIME_PATH"
fi

# Check for mkdwarfs - download dwarfs-universal if not available
MKDWARFS_PATH="$SCRIPT_DIR/resources/mkdwarfs"
MKDWARFS_CMD=""

if [ -f "$MKDWARFS_PATH" ]; then
  MKDWARFS_CMD="$MKDWARFS_PATH"
elif command -v mkdwarfs >/dev/null 2>&1; then
  MKDWARFS_CMD="mkdwarfs"
elif $TOOLBOX_RUN command -v mkdwarfs >/dev/null 2>&1; then
  MKDWARFS_CMD="$TOOLBOX_RUN mkdwarfs"
else
  echo "mkdwarfs not found. Downloading dwarfs-universal..."
  # Get latest version
  DWARFS_VERSION=$(curl -sI "https://github.com/mhx/dwarfs/releases/latest" | grep -i location | sed 's/.*tag\/v//' | tr -d '\r\n')
  DWARFS_URL="https://github.com/mhx/dwarfs/releases/download/v${DWARFS_VERSION}/dwarfs-universal-${DWARFS_VERSION}-Linux-${ARCH}"
  if ! curl -L -o "$MKDWARFS_PATH" "$DWARFS_URL" 2>/dev/null; then
    echo "Error: Failed to download dwarfs-universal from $DWARFS_URL"
    exit 1
  fi
  chmod +x "$MKDWARFS_PATH"
  MKDWARFS_CMD="$MKDWARFS_PATH"
fi

# Create DwarFS image from AppDir
DWARFS_IMAGE="${PKG_NAME}.dwarfs"
echo "Creating DwarFS image from AppDir..."
if ! $MKDWARFS_CMD -i "$APPDIR" -o "$DWARFS_IMAGE" --no-progress -l5; then
  echo "Error: Failed to create DwarFS image"
  exit 1
fi

# Combine uruntime with DwarFS image to create AppImage
echo "Creating AppImage with uruntime..."
cat "$URUNTIME_PATH" "$DWARFS_IMAGE" > "$OUTPUT_APPIMAGE"

# Cleanup temporary DwarFS image
rm -f "$DWARFS_IMAGE"

if [ -f "$OUTPUT_APPIMAGE" ]; then
  echo "Done: $OUTPUT_APPIMAGE"
  # Cleanup build directory unless debug is passed
  if [ "$DEBUG" = false ]; then
    echo "Cleaning up build directory $APPDIR..."
    rm -rf "$APPDIR"
  else
    echo "Debug mode: keeping build directory $APPDIR"
  fi
else
  echo "Error: AppImage generation failed."
  exit 1
fi
