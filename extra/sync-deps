# Safe bash settings and options
set -euo pipefail
shopt -s nullglob

# Determine project root (parent of the directory containing this script)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Usage and option parsing
usage() {
  cat <<EOF
Usage: $0 [--dry-run] [--keep-tmp] [--verbose] <package>

Options:
  --dry-run   Show actions without extracting files
  --keep-tmp  Keep files in tmp/ after operation
  --verbose   Show additional info
  --help      Show this help
EOF
  exit 1
}

DRY_RUN=false
KEEP_TMP=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --keep-tmp) KEEP_TMP=true; shift ;;
    --verbose) VERBOSE=true; shift ;;
    --help) usage ;;
    --*) echo "Unknown option: $1"; usage ;;
    *) break ;;
  esac
done

# Check positional argument
if [ $# -lt 1 ]; then
  echo "Error: package argument is missing."
  usage
fi

# Initialize variables
PKG="$1"
APPDIR="$PROJECT_ROOT/$PKG.AppDir"
TMP_DIR="$PROJECT_ROOT/tmp"

# Make AppDir folder
mkdir -p "$APPDIR"

verbose() { $VERBOSE && echo "$@"; }

# Find rpm files
files=("$TMP_DIR"/*.rpm)
if [ ${#files[@]} -eq 0 ]; then
  verbose "No RPMs found in $TMP_DIR/; nothing to do."
  exit 0
fi

# Loop through all RPM files in tmp folder
for rpm_file in "${files[@]}"; do
  [ -f "$rpm_file" ] || continue

  # Try to query package name from RPM metadata
  name=$(rpm -qp --qf '%{NAME}\n' "$rpm_file" 2>/dev/null || true)
  if [ -z "$name" ]; then
    # Fallback heuristic: strip version/release/arch from filename (best-effort)
    name=$(basename "$rpm_file" .rpm)
    name=${name%%-*}
    verbose "Warning: could not read NAME from $rpm_file; falling back to '$name'"
  fi

  # If package is already provided by host, remove it
  if rpm -q "$name" >/dev/null 2>&1; then
    verbose "Package $name appears installed on host; removing $rpm_file"
    rm -f -- "$rpm_file"
    continue
  fi

  echo "Extracting $rpm_file to AppDir"
  if $DRY_RUN; then
    echo "DRY-RUN: would extract $rpm_file to $APPDIR"
    continue
  fi

  if rpm2cpio "$rpm_file" | (cd "$APPDIR" && cpio -idm); then
    verbose "Successfully extracted $rpm_file"
    rm -f -- "$rpm_file"
  else
    echo "Error: failed to extract $rpm_file" >&2
    exit 1
  fi
done

# Cleanup tmp unless requested to keep (don't delete in dry-run)
if [ "$KEEP_TMP" = false ] && [ "$DRY_RUN" = false ]; then
  rm -f -- "$TMP_DIR"/*.rpm || true
fi

